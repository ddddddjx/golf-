/* TR4CE 小程序 — 全局样式: 石墨底 + 琥珀描迹色, 克制干净 */
page {
  --bg: #0d1117;
  --panel: rgba(22, 28, 36, 0.92);
  --glass: rgba(13, 17, 23, 0.62);
  --stroke: rgba(255, 255, 255, 0.10);
  --text: #e8edf2;
  --text-dim: #8b98a5;
  --accent: #ff8a3c;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.btn-primary {
  background: var(--accent);
  color: #1a0e02;
  font-weight: 700;
  font-size: 32rpx;
  border-radius: 999rpx;
  padding: 26rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text);
  font-weight: 600;
  font-size: 30rpx;
  border-radius: 999rpx;
  padding: 24rpx 0;
  text-align: center;
  border: 1rpx solid var(--stroke);
  line-height: 1.4;
}
.btn-ghost::after { border: none; }
