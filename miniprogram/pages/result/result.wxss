.page { width: 100vw; height: 100vh; position: relative; background: #000; overflow: hidden; }

.video, .overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.overlay { pointer-events: none; }

.topbar {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  left: 24rpx;
}
.back {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--glass);
  border: 1rpx solid var(--stroke);
  color: #fff;
  font-size: 48rpx;
  line-height: 60rpx;
  text-align: center;
}

.panel {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  background: var(--panel);
  border-top: 1rpx solid var(--stroke);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 36rpx calc(28rpx + env(safe-area-inset-bottom));
  backdrop-filter: blur(16px);
}

.type-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.type-emoji { font-size: 64rpx; }
.type-text { flex: 1; display: flex; flex-direction: column; }
.type-name { font-size: 44rpx; font-weight: 900; letter-spacing: 2rpx; }
.type-zh { font-size: 26rpx; color: var(--text-dim); margin-top: 4rpx; }
.carry { text-align: right; display: flex; flex-direction: column; }
.carry-num { font-size: 72rpx; font-weight: 900; color: var(--accent); line-height: 1; }
.carry-unit { font-size: 22rpx; color: var(--text-dim); margin-top: 6rpx; }

.stat-grid {
  display: flex;
  gap: 16rpx;
}
.stat {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid var(--stroke);
  border-radius: 18rpx;
  padding: 18rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.stat .k { font-size: 22rpx; color: var(--text-dim); }
.stat .v { font-size: 40rpx; font-weight: 800; }
.stat .u { font-size: 22rpx; color: var(--text-dim); margin-left: 4rpx; font-weight: 400; }

.note { font-size: 22rpx; color: var(--text-dim); margin: 16rpx 4rpx 20rpx; }

.btn-row { display: flex; gap: 16rpx; }
.half { flex: 1; }
.share-btn { margin-top: 16rpx; width: 100%; }

.poster-canvas {
  position: absolute;
  left: -9999rpx;
  top: 0;
  width: 750px;
  height: 1200px;
}
